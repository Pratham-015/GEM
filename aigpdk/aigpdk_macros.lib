/* SPDX-License-Identifier: Apache-2.0 */
/* Liberty definitions for GEM native Xilinx hardware macros */
library(aigpdk_macros) {
  delay_model : table_lookup;
  time_unit : "1ps";
  voltage_unit : "1V";
  current_unit : "1uA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  capacitive_load_unit (1,pf);

  type ( bus_4 ) {
    base_type : array ;
    data_type : bit ;
    bit_width : 4 ;
    bit_from : 3 ;
    bit_to : 0 ;
    downto : true ;
  }

  type ( bus_5 ) {
    base_type : array ;
    data_type : bit ;
    bit_width : 5 ;
    bit_from : 4 ;
    bit_to : 0 ;
    downto : true ;
  }

  type ( bus_2 ) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2 ;
    bit_from : 1 ;
    bit_to : 0 ;
    downto : true ;
  }

  type ( bus_18 ) {
    base_type : array ;
    data_type : bit ;
    bit_width : 18 ;
    bit_from : 17 ;
    bit_to : 0 ;
    downto : true ;
  }

  type ( bus_27 ) {
    base_type : array ;
    data_type : bit ;
    bit_width : 27 ;
    bit_from : 26 ;
    bit_to : 0 ;
    downto : true ;
  }

  type ( bus_48 ) {
    base_type : array ;
    data_type : bit ;
    bit_width : 48 ;
    bit_from : 47 ;
    bit_to : 0 ;
    downto : true ;
  }

  cell (CARRY4) {
    area : 16;
    pin(CI) { direction : input; }
    pin(CYINIT) { direction : input; }
    bus(DI) { bus_type : bus_4; direction : input; }
    bus(S) { bus_type : bus_4; direction : input; }
    bus(CO) { bus_type : bus_4; direction : output; }
    bus(O) { bus_type : bus_4; direction : output; }
  }

  cell (DSP48E2) {
    area : 128;
    pin(CLK) { direction : input; clock : true; }
    pin(USE_PRE) { direction : input; }
    bus(A) { bus_type : bus_27; direction : input; }
    bus(D) { bus_type : bus_27; direction : input; }
    bus(B) { bus_type : bus_18; direction : input; }
    bus(C) { bus_type : bus_48; direction : input; }
    bus(STATE) { bus_type : bus_2; direction : input; }
    bus(P) { bus_type : bus_48; direction : output; }
  }

  cell (SRLC32E) {
    area : 32;
    pin(CLK) { direction : input; clock : true; }
    pin(CE) { direction : input; }
    pin(D) { direction : input; }
    pin(Q) { direction : output; }
    pin(Q31) { direction : output; }
    bus(A) { bus_type : bus_5; direction : input; }
  }
}

