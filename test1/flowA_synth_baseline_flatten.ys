# FLOW A (BASELINE): Flatten everything including CARRY4.
# CARRY4 is replaced with a plain behavioral inline model so
# Yosys/ABC can see its logic and reduce it to AIG cells.

# 1. Read a behavioral (whitebox) CARRY4 model so synth can see through it
read_verilog -sv test1/carry4_behavioral.sv

# 2. Read the test circuit
read_verilog -sv test1/test_circuit.sv

# 3. Check hierarchy and set top module
hierarchy -check -top test_circuit

# Logic synthesis & flattening
# 4. Executing Synth pass (Multiple passes)
synth -flatten
# Deletes Print/Display statements in netlist
delete t:$print

# Standard cell and gate-level mapping targeting GEM's AIG PDK
# 5. Executing DFF Libmap Pass
dfflibmap -liberty aigpdk/aigpdk_nomem.lib

# 6. Executing Opt Clean pass
opt_clean -purge

# 7,8. Executing ABC
abc -liberty aigpdk/aigpdk_nomem.lib
opt_clean -purge

# 9,10,11. Executing Techmap
techmap
abc -liberty aigpdk/aigpdk_nomem.lib
opt_clean -purge

# Write out structural gate-level netlist in AIG format
# 12. Writes AIG to .gv file
write_verilog -noexpr -nodec test1/flowA_gatelevel_baseline.gv

# 13. Printing statistics
# stat